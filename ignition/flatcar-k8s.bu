variant: flatcar
version: 1.0.0

# Flatcar k8s node — installs containerd + kubeadm/kubelet/kubectl via systemd-sysext.
# Does NOT run `kubeadm init` or `kubeadm join` — configure role manually after boot.

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        # BEGIN MANAGED SSH KEYS
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPuoDofo5+qGtLAHzvsvjZKdK6N+kmi4qI3JSwOqTt2p aloks98@titanair.local
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINbY4fAHtL2YnQji5aqrjpTCcmC9b0s0BtJebPjAEVIJ aloks98@fatman
        # END MANAGED SSH KEYS
    - name: root
      ssh_authorized_keys:
        # BEGIN MANAGED SSH KEYS
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPuoDofo5+qGtLAHzvsvjZKdK6N+kmi4qI3JSwOqTt2p aloks98@titanair.local
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINbY4fAHtL2YnQji5aqrjpTCcmC9b0s0BtJebPjAEVIJ aloks98@fatman
        # END MANAGED SSH KEYS

storage:
  files:
    # Verified by Ignition before the guest reaches systemd. Digest from the
    # upstream kubernetes-v1.35.5 release SHA256SUMS; update both together.
    - path: /opt/extensions/kubernetes/kubernetes-v1.35.5-x86-64.raw
      mode: 0644
      contents:
        source: https://extensions.flatcar.org/extensions/kubernetes-v1.35.5-x86-64.raw
        verification:
          hash: sha256-883e6337897ff987db650d47113c1d3b5fe142819a4f0d36e8ea5ceb764fbe22

    - path: /etc/ssh/sshd_config.d/00-pvectgen-access.conf
      mode: 0644
      contents:
        inline: |
          PermitRootLogin prohibit-password
          PasswordAuthentication no
          KbdInteractiveAuthentication no
          PubkeyAuthentication yes

    # kubelet config — generated by kubeadm, leave for it.

    # Module load for containerd
    - path: /etc/modules-load.d/k8s.conf
      mode: 0644
      contents:
        inline: |
          overlay
          br_netfilter

    # Sysctl for k8s
    - path: /etc/sysctl.d/99-kubernetes-cri.conf
      mode: 0644
      contents:
        inline: |
          net.bridge.bridge-nf-call-iptables  = 1
          net.bridge.bridge-nf-call-ip6tables = 1
          net.ipv4.ip_forward                 = 1

  links:
    # Enable kubernetes sysext images for kubelet/kubeadm/kubectl + crictl + cni-plugins
    - path: /etc/extensions/kubernetes.raw
      target: /opt/extensions/kubernetes/kubernetes-v1.35.5-x86-64.raw
      hard: false

systemd:
  units:
    # Mount containerd's systemd unit (Flatcar ships containerd)
    - name: containerd.service
      enabled: true

    # Configure systemd-sysext to scan /etc/extensions/
    - name: systemd-sysext.service
      enabled: true

    # The extension supplies kubelet.service, kubeadm arguments, and the
    # multi-user.target dependency. Do not override its packaged unit.
