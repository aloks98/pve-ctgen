[
  {
    "name": "Resize disk",
    "command": "qemu-img resize {{.FilePath}} {{.DiskSize}}"
  },
  {
    "name": "Create VM",
    "command": "qm create {{.ID}} --name {{.Name}}-{{.ID}}-cloudinit --ostype l26 --memory 1024 --agent 1 --bios ovmf --machine q35 --efidisk0 {{.Storage}}:0,pre-enrolled-keys=0 --cpu host --socket 1 --cores 2 --vga serial0 --serial0 socket --net0 virtio,bridge={{.Bridge}}"
  },
  {
    "name": "Import disk",
    "command": "qm importdisk {{.ID}} {{.FilePath}} {{.Storage}} --format {{.DiskFormat}}"
  },
  {
    "name": "Set disk options",
    "command": "qm set {{.ID}} --scsihw virtio-scsi-pci --virtio0 {{.ImportedDisk}},discard=on"
  },
  {
    "name": "Set boot options",
    "command": "qm set {{.ID}} --boot order=virtio0"
  },
  {
    "name": "Set cloud-init",
    "command": "qm set {{.ID}} --scsi1 {{.Storage}}:cloudinit"
  },
  {
    "name": "Set IP configuration",
    "command": "qm set {{.ID}} --ipconfig0 ip=dhcp"
  },
  {
    "name": "Set tags",
    "command": "if [ -n \"{{.Tags}}\" ]; then qm set {{.ID}} --tags \"{{.Tags}}\"; fi"
  },
  {
    "name": "Set cloud-init user data",
    "command": "if [ -n \"{{.Vendor}}\" ]; then qm set {{.ID}} --cicustom user={{.SnippetStorage}}:snippets/{{.Vendor}}; fi"
  },
  {
    "name": "Convert to template",
    "command": "qm template {{.ID}}"
  }
]
